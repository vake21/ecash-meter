# /etc/systemd/system/ecash-node.service
[Unit]
Description=eCash (ECX) mainnet node for eCash Meter
Documentation=https://github.com/vake21/ecash-meter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ecash
Group=ecash
ExecStart=/usr/local/bin/bitcoind -conf=/etc/ecash/ecash.conf -datadir=/var/lib/ecash
Restart=on-failure
RestartSec=10
# The node flushes its chainstate on shutdown; killing it early can corrupt the
# DB, and flushing a mainnet-sized UTXO set is not instant.
TimeoutStopSec=600
KillSignal=SIGTERM

# Hardening. ProtectSystem=strict makes the filesystem read-only, so the datadir
# has to be granted back explicitly.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ecash
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
