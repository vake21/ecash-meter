# Install at /etc/ecashmeter/indexer.env  (chmod 0640, root:ecashmeter)
#
# Environment for ecashmeter-index.service. This file HOLDS A SECRET — the RPC
# password. Keep it out of git; only the .example belongs in the repo.

NODE_ENV=production

ECASH_METER_DB=/var/lib/ecashmeter/ecash-meter.sqlite

# The eCash node on this same box. ECX mainnet JSON-RPC is 8532, and RPC is
# bound to localhost only.
ECASH_RPC_URL=http://127.0.0.1:8532

# Must match the rpcauth= line in /etc/ecash/ecash.conf. deploy/README.md step 4
# generates both halves: the rpcauth line for the node and the plaintext
# password for here.
#
# Do NOT leave these as user/password — lib/rpc.ts warns about exactly that, and
# on a public host it is a real hole even bound to localhost.
ECASH_RPC_USER=ecashmeter
ECASH_RPC_PASS=REPLACE_ME

# Give up on a hung RPC rather than holding the timer's slot open — but leave
# real headroom. A node flushing its UTXO cache stalls every RPC for tens of
# seconds, and at 30000 that aborts a backfill mid-run. 120s rides it out.
ECASH_RPC_TIMEOUT_MS=120000

# FIRST RUN ONLY: back-fill all the way to the ECX fork (height 973,728). The
# indexer clamps the start to the fork, so an oversized value just means "from
# the fork". This is required, not cosmetic: each sidechain's treasury balance
# ("In sidechain") is replayed from every deposit and withdrawal since its
# activation (978,324+), and a store that starts later shows it as "unknown".
# (A fixed depth like 10,000 stops reaching the fork as the chain grows — at
# ~614 blocks/day it was outrun within days of launch.)
# Later runs resume from the stored tip and ignore this.
#
# ⚠ With prune=40000 (~107 days of blocks), a FROM-SCRATCH rebuild only works
# while the node still holds the fork-era blocks. After that, rebuilding the
# store needs an unpruned node (or a copy of the old store).
#
# These are real mainnet blocks — some carry thousands of transactions, and
# verbosity 3 includes every input's prevout, so a block's JSON is large. The
# indexer fetches in bounded chunks (ECASH_INDEX_CHUNK) so a deep backfill does
# not have to hold the whole range in memory at once.
ECASH_BACKFILL_BLOCKS=1000000

# Blocks fetched + committed per chunk during a backfill. Lower it if the box is
# memory-tight, raise it on a roomy one. Default 20: 250 exhausted Node's
# ~1.6 GB heap on a 4 GB box, catching up only 158 blocks.
ECASH_INDEX_CHUNK=20

# Concurrent JSON-RPC requests. MUST stay below the node's rpcthreads (default
# 10). A verbosity-3 getblock on a real mainnet block is expensive to serialize,
# so over-subscribing starves light calls like getblockhash behind the heavy
# ones until they hit ECASH_RPC_TIMEOUT_MS and the run aborts. Raise the node's
# rpcthreads if you want to raise this.
ECASH_RPC_CONCURRENCY=8
