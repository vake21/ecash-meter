# Copy this file to `.env.local` and adjust as needed.
# `.env.local` is gitignored (it may hold machine-specific values); this example
# is committed so others know what settings the app understands.

# The site ALWAYS reads the SQLite store below and nothing else; only the
# indexer (`npm run index`) talks to the node. If the store is missing, empty,
# unreadable or built for another chain/parser, the page shows "Data
# temporarily unavailable" — it never substitutes sample figures.
# (ECASH_SOURCE and ECASH_LIVE are gone; they are ignored if still set.)

# Persistent history store: a local SQLite file (Node's built-in node:sqlite).
# Optional — defaults to ./.data/ecash-meter.sqlite. Set to relocate.
ECASH_METER_DB=.data/ecash-meter.sqlite

# DEVELOPMENT/DEMO ONLY: set to 1 to show sample data instead of the store, e.g.
# to work on the UI without a node. Every view is labelled "DEMO — SAMPLE DATA"
# and /api/health reports 503 "demo". Never set this in production.
# ECASH_DEMO=1

# ── Indexer only ── (the website never reads these)
#
# Mainchain JSON-RPC — ONE eCash (ECX) mainnet node. The indexer verifies the
# node's block at the ECX fork height before indexing anything. A stock eCash `bitcoind`
# serves mainnet JSON-RPC on 8532 (P2P is 8533). Never ship the placeholder
# credentials: generate an rpcauth line on the server (see deploy/README.md).
ECASH_RPC_URL=http://127.0.0.1:8532
ECASH_RPC_USER=user
ECASH_RPC_PASS=password

# Concurrent JSON-RPC requests. Keep BELOW the node's rpcthreads (default 10):
# verbosity-3 getblock on real mainnet blocks is heavy enough that
# over-subscribing starves light calls and they hit ECASH_RPC_TIMEOUT_MS.
ECASH_RPC_CONCURRENCY=8

# How many blocks the indexer backfills on its FIRST run. Later runs only fetch
# blocks newer than what's stored. The start clamps to the ECX fork (973,728),
# and the store SHOULD reach it: treasury balances and the activation/proposal
# replay need history back to the fork, and otherwise show as unknown.
ECASH_BACKFILL_BLOCKS=1000000
